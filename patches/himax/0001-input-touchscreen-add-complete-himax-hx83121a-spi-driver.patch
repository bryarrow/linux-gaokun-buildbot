diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 9b9ae8a..8987520 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1414,4 +1414,32 @@ config TOUCHSCREEN_HIMAX_HX83112B
 	  To compile this driver as a module, choose M here: the
 	  module will be called himax_hx83112b.
 
+config TOUCHSCREEN_HIMAX_HX83121A_SPI
+	tristate "Himax HX83121A SPI touchscreen driver"
+	depends on SPI
+	select DRM_PANEL_BRIDGE
+	help
+	  Say Y here to enable support for Himax HX83121A touchscreens
+	  connected over SPI.
+
+	  This driver provides a complete touch-processing pipeline with
+	  CMF filtering, IIR temporal smoothing, palm rejection, weighted
+	  centroid detection, and multi-touch tracking.
+
+	  If unsure, say N.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called himax_hx83121a_spi.
+
+config TOUCHSCREEN_HIMAX_HX83121A_DIAGNOSTICS
+	bool "Himax HX83121A full-rate diagnostic capture"
+	depends on TOUCHSCREEN_HIMAX_HX83121A_SPI
+	help
+	  Build the full-rate event trace and read-only diagnostic sysfs
+	  snapshots used to investigate intermittent touch dropouts. This adds
+	  per-interrupt matrix/event-stack copies and about 10.3 MiB of trace
+	  storage per device.
+
+	  Leave this disabled for normal use. Enable it only in kernels intended
+	  for capture with the Himax diagnostic app.
 endif
