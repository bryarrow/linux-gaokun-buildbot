+static inline s16 hx_frame_at(const struct hx_algo *algo, int row, int col)
+{
+	s16 value;
+
+	if (row < 0 || row >= HX_ROWS || col < 0 || col >= HX_COLS)
+		return 0;
+	value = algo->frame[row][col];
+	return value > 0 ? value : 0;
+}
